{"page": 54, "w": 882, "h": 1264, "lines": [[92.0, 33.0, 348.0, 52.0, "46 CUMHUAIYET'INÇINLI MISAFIALEAI", 0.979], [389.0, 643.0, 521.0, 667.0, "Alfred Sze, 1912.", 0.999], [150.0, 698.0, 789.0, 728.0, "Alfred Sze (Shi Zhaoji), Çin Cumhuriyeti'nin ABD'deki ilk", 0.991], [120.0, 732.0, 790.0, 761.0, "büyükelçisi, Cumhuriyetçi Çin’in seçkin bir diplomati ve politi-", 0.98], [117.0, 760.0, 792.0, 794.0, "kacisydi. Çin'in güneyindeki Jiang Su eyaletinde 4 Ekim 1877'de", 0.965], [119.0, 794.0, 791.0, 824.0, "doğdu. Bati tarzi bir eğitim aldi; yabanci dil ve modern bilim tah-", 0.984], [118.0, 823.0, 792.0, 856.0, "sili yapti. 1892 yılinda, 15 yaşındayken Qing Hanedaninin ABD", 0.954], [119.0, 853.0, 792.0, 887.0, "Büyükelçiliğinde tercüman olarak görev yapti. 1896'da ABD'de", 0.985], [119.0, 884.0, 792.0, 917.0, "Cornell Üniversitesinde öğrenim görmeye başladi. Bu arada hâlâ", 0.98], [121.0, 918.0, 790.0, 948.0, "Qing elçiliği için çalıyordu. 1899 Lahey görüşmelerine Çinli dele-", 0.974], [118.0, 946.0, 792.0, 981.0, "gasyonun bir üyesi olarak katildi. 1901'de Cornell Üniversitesi'n-", 0.988], [120.0, 980.0, 791.0, 1009.0, "den mezun oldu ve 1902'de Çin’e döndü. 1902-1907 arasinda Çin", 0.976], [121.0, 1008.0, 792.0, 1042.0, "Yurtdışı Öğrenci Topluluklari'nin başı olarak çalişti ve Bati politik", 0.924], [121.0, 1043.0, 792.0, 1072.0, "düşüncesi üzerine çeşitli kitaplar derledi. 1907'de Jilin eyaletine", 0.986], [121.0, 1073.0, 792.0, 1102.0, "demiryollari sorumlusu olarak tayin edildi. Kisa bir süre sonra di-", 0.99], [120.0, 1104.0, 476.0, 1136.0, "şişleri bakanliğina aday gösterildi.1", 0.968], [148.0, 1163.0, 790.0, 1186.0, "Zhou Huiping, \"Çin Cumhuriyeti Diplomat Shi Zhaoji\", Min Guo Dang An (Cumhu-", 0.977], [148.0, 1183.0, 791.0, 1211.0, "riyet Arsivleri), say1 2,1992,s. 139-142.“”, no:", 0.935], [150.0, 1209.0, 264.0, 1231.0, "2 (1992):139.", 0.994]]}
{"page": 58, "w": 882, "h": 1264, "lines": [[91.0, 33.0, 347.0, 52.0, "50 CUMHUAIYETIN ÇINLI MISAFIALEAI", 0.968], [389.0, 695.0, 520.0, 719.0, "Alfred Sze, 1931.", 0.999], [151.0, 737.0, 788.0, 766.0, "Alfred Sze için ekonomi çok önemliydi. Bu sebeple tekrar tek-", 0.993], [118.0, 768.0, 788.0, 797.0, "rar kapitülasyonlarin kaldirilmasinin altini çizmektedir. 1925 y1-", 0.947], [119.0, 800.0, 790.0, 829.0, "lina ait bir arşiv belgesine göre, Türkiye'ye gitmeden hemen önce", 0.987], [121.0, 830.0, 790.0, 860.0, "ABD'yle yapilmiş ve adil olmayan bir anlamayi revize etmeye", 0.969], [119.0, 861.0, 789.0, 891.0, "hatta mümkün olursa iptal etmeye çalşıyordu.11 Sadece o değil,", 0.967], [118.0, 891.0, 789.0, 921.0, "dönemin Türk karar mercileri ve Türkiye Cumhuriyeti'nin kuru-", 0.983], [119.0, 961.0, 789.0, 984.0, "11 Shi Zhaoji, \"Antlaşmalari Değiştirme Meselesi\", Ağustos 1925, 03-16-043-02-011, JS-", 0.972], [150.0, 983.0, 790.0, 1005.0, "SDAG /  (Beiyang Hükümeti Dsisleri Bakanliğı); “", 0.913], [150.0, 1003.0, 791.0, 1029.0, "”, Ağustos 1925, 03-16-043-02-011, JSSDAG / ; Shi Zhaoji, \"Ant-", 0.951], [147.0, 1025.0, 791.0, 1053.0, "lamalar1 Değiştirme Meselesi\", Temmuz 1925, 03-16-043-02-002, JSSDAG / ", 0.966], [149.0, 1049.0, 792.0, 1074.0, " (Beiyang Hükümeti Dışisleri Bakanl); \"\", Temmuz", 0.908], [150.0, 1071.0, 791.0, 1097.0, "1925, 03-16-043-02-002, JSSDAG/ ; Shi Zhaoj, \"Adil Olmayan Ant-", 0.95], [149.0, 1094.0, 790.0, 1119.0, "lagmalarn Iptali Meselesi\", Haziran 1925, 03-23-019-02-004, JSSDAG / t", 0.952], [149.0, 1115.0, 792.0, 1142.0, " (Beiyang Hükümeti Disleri Bakanliğ); “\", Haziran", 0.926], [151.0, 1141.0, 790.0, 1163.0, "1925, 03-23-019-02-004, JSSDAG / ; Shi Zhaoji, “Adil Olmayan Ant-", 0.96], [150.0, 1163.0, 790.0, 1186.0, "laşmalarin Iptali Meselesi Üzerine\", Haziran 1925, 03-23-102-03-002, JSSDAG / ", 0.982], [148.0, 1205.0, 616.0, 1231.0, "Haziran 1925, 03-23-102-03-002, JSSDAG /t.", 0.949]]}
{"page": 76, "w": 882, "h": 1264, "lines": [[91.0, 32.0, 346.0, 51.0, "68 CUMHURIYET'INÇINLI MISAFIALEAI", 0.963], [200.0, 578.0, 710.0, 603.0, "Hu Hanmin, Sun Ke Dişleri Bakanliğ’nda, Ankara, 16 Mart 1928.", 0.982], [150.0, 633.0, 498.0, 666.0, "Vekil ilk soruya şöyle cevap verdi:", 0.991], [193.0, 696.0, 792.0, 725.0, "Dini ideolojiyi istemiyoruz cünkü hedeflerimize ulasabilmemiz icin bu", 0.977], [161.0, 727.0, 792.0, 755.0, "ideoloji yeterli degil. Bazilari söyle diyor: \"Islam'in ruhu cesarettir. Türki-", 0.974], [160.0, 756.0, 792.0, 785.0, "ye'nin kurtuluu ve ulus inas da Islam'la yakindan ilgilidir.\" Aslinda bu", 0.95], [160.0, 787.0, 792.0, 816.0, "ifade tamamen gerçegi yansimamaktadr, geçmite giriilen savalarda", 0.973], [160.0, 817.0, 676.0, 845.0, "en cesur ve siddetli savascilarin birçogu Müslüman degildi.", 0.968], [149.0, 876.0, 790.0, 906.0, "Söylediklerinin hepsinde bir haklilik pay1 bulunuyordu ancak", 0.984], [120.0, 906.0, 791.0, 934.0, "Türkiye'nin kurtuluşunda Islam’in da rolü vardi. Tarihte Müslü-", 0.974], [118.0, 936.0, 791.0, 965.0, "manlar bir ellerinde kiliç diğer ellerinde Kuran ile birçok ülke kur-", 0.983], [120.0, 966.0, 790.0, 994.0, "du. Bu ruh, Türklerin kaninda vardir ve bu da öyle zamanlardan", 0.98], [119.0, 996.0, 791.0, 1025.0, "biridir! Türkiye’nin iç sorunlarinın çözümü ve büyük sikintilarin", 0.948], [118.0, 1026.0, 791.0, 1056.0, "yaşandiğr dönemin ardindan ülkenin kurtuluşu ve yeniden inşasi", 0.961], [118.0, 1055.0, 792.0, 1086.0, "için yepyeni rafine bir ruh ortaya çıkmıştır. Türkler bu inanilmaz", 0.964], [118.0, 1085.0, 791.0, 1116.0, "başariya nasil ulaşacaklarini bilmiyorlardi. Bu başariya milliyet-", 0.952], [118.0, 1115.0, 791.0, 1146.0, "çilik ruhuyla ulaşılacağini düşündüler ve Islam’in ruhunu unuttu-", 0.972], [118.0, 1146.0, 790.0, 1175.0, "lar.² Buna, “Bedeni Lu Shan Dağrnda olup da Lu Shan Dağl'ni", 0.947], [117.0, 1205.0, 704.0, 1230.0, "2Su Shiin bir sirinden alintidir.() (G.F.).", 0.936]]}
{"page": 96, "w": 882, "h": 1264, "lines": [[90.0, 250.0, 348.0, 273.0, "88 CUMHUAIYET'IN ÇINLI MISAFIALEAI", 0.961], [383.0, 863.0, 528.0, 886.0, "General He Yaozu.", 0.98], [148.0, 914.0, 792.0, 948.0, "He Yaozu, 1889'da dünyaya geldi. Türkiye'ye atanan ilk Çin", 0.983], [120.0, 981.0, 786.0, 1010.0, "leşmesi ve ulus inşasi süreciyle ilgili çok sayida metin kaleme aldi.", 0.983]]}
