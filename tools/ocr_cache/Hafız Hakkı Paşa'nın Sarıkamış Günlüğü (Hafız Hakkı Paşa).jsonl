:", 0.965], [61.0, 1090.0, 745.0, 1126.0, "Fitrat-1 güzîdenizi, asalet-i rûhiyenizi, hakiki fikir ve hayat", 0.994], [60.0, 1118.0, 364.0, 1150.0, "kardaşliğinizi gösterdiniz.", 0.987], [100.0, 1145.0, 784.0, 1180.0, "Emîn olunuz Talât Beyefendi, kadirşinasliğinizi mâdâmel-", 0.97], [61.0, 1172.0, 776.0, 1207.0, "ömür mâbed-i vicdânimin kürsi-i muallâsinda yegâne hatîb-i", 0.981], [60.0, 1200.0, 736.0, 1235.0, "tesliyetsazi olarak yaşatacağim. Ruhu melã-i alâda gezen", 0.952], [60.0, 1226.0, 744.0, 1261.0, "evlâdimın hatirasina karşı izhar buyurduğunuz hürmet ve", 0.965], [86.0, 1290.0, 750.0, 1322.0, "62 BOA, 28 C 1333, Dosya No: 64, Gömlek No: 22, Fon Kodu: DH. KMS.", 0.992]]}
{"page": 124, "w": 833, "h": 1335, "lines": [[773.0, 5.0, 832.0, 41.0, "121", 1.0], [37.0, 105.0, 725.0, 133.0, "sadakat-1 necîbâneniz âcîzelerini cidden teshîr ve müteselli", 0.982], [37.0, 132.0, 721.0, 161.0, "eyledi. Hâmî-i ahyâr olan Allah-1 z’ül-celâl hazretleri sizleri", 0.985], [36.0, 162.0, 740.0, 188.0, "ve aziz ve fedâkâr rüfeka-yi mesâînizi mazarr-1 münâfikîn ve", 0.982], [36.0, 188.0, 608.0, 217.0, "à’dâdan masun ve muvaffak bil-âmâl buyursun.", 0.964], [76.0, 215.0, 705.0, 243.0, "Delâlet ve himmet-i kerîmâneleri ile tahsis buyurulan", 0.995], [36.0, 241.0, 756.0, 270.0, "4000 kuruşun cüzdanlarn ile 331 Nisani'nin nihayetine kadar", 0.967], [37.0, 268.0, 727.0, 297.0, "olan matlúbati ve ayrica hâne için tefrîk ve irsâl buyurulan", 0.98], [38.0, 298.0, 648.0, 324.0, "500 lirayi biraderzâdem Es’ad Bey vasitasi ile aldim.", 0.98], [76.0, 324.0, 768.0, 353.0, "Zerre-i şükrünü bile ödeyemeyeceğim şu lútuftan dolayi da", 0.987], [36.0, 351.0, 733.0, 379.0, "en samimî teşekkürâtimi takdim ile kesb-i fahr eylerim, âli-", 0.983], [36.0, 378.0, 694.0, 407.0, "kadr beyefendi oğlum... 30 Nisan 1331 (13 Mayis 1915).", 0.999], [410.0, 432.0, 727.0, 459.0, "Merhum Hfiz Ismail Hakki", 0.968], [494.0, 460.0, 602.0, 487.0, "Paşa’nun", 0.938], [478.0, 487.0, 660.0, 514.0, "validesi Habibe", 0.975], [520.0, 513.0, 616.0, 543.0, "(Mühür)", 0.971]]}
{"page": 143, "w": 833, "h": 1337, "lines": [[5.0, 3.0, 71.0, 40.0, "140", 1.0], [72.0, 101.0, 771.0, 145.0, "kurtarmak için nâmlanniza lâzim gelen teşebbüslerde bulunmak", 0.979], [71.0, 128.0, 701.0, 171.0, "üzere bana vekâlet veriniz. Bu mal, Sultan Abdülhamid’in", 0.98], [71.0, 156.0, 798.0, 201.0, "evldlarnin iddiasi gibi babalannin mali değildir. Hiçbir padişahin,", 0.965], [71.0, 184.0, 736.0, 225.0, "hiçbir kimsenin mali değildir. Umüm hanedan äzâsinin hakki", 0.957], [71.0, 211.0, 755.0, 254.0, "olan bir maldir” dedi. Ağzimiza birer kaşık bal çaldi. Biz de hiç", 0.971], [69.0, 240.0, 675.0, 279.0, "düşünmeyerek, muhakeme etmeyerek, “Pekal\" dedik.", 0.981], [111.0, 271.0, 248.0, 297.0, "Bu mallarin", 0.944], [71.0, 296.0, 278.0, 326.0, "bizim, yani umûm", 0.987], [71.0, 321.0, 287.0, 353.0, "ailenin müştereken", 0.972], [71.0, 352.0, 282.0, 379.0, "ve müsâvaten mali", 0.998], [69.0, 376.0, 275.0, 408.0, "olduğunu ifade ve", 0.999], [68.0, 403.0, 287.0, 435.0, "tasdik eder, bildirir", 0.999], [69.0, 431.0, 302.0, 463.0, "kâğitlari, mektuplari", 0.95], [71.0, 461.0, 325.0, 486.0, "elimizdedir. Vekâletleri", 0.996], [365.0, 455.0, 784.0, 475.0, "12", 0.505], [70.0, 487.0, 297.0, 514.0, "alinca bizlere itimad", 0.998], [70.0, 515.0, 312.0, 542.0, "vermek için içimizden", 0.977], [68.0, 539.0, 281.0, 571.0, "bir encümen teşkil", 0.967], [70.0, 569.0, 285.0, 596.0, "ettirdi. Bu nasil bir", 0.984], [67.0, 594.0, 296.0, 626.0, "hak almak için para", 0.987], [69.0, 624.0, 272.0, 651.0, "verilirse, Halife de", 1.0], [67.0, 649.0, 253.0, 678.0, "bizim gözümüzü", 0.998], [69.0, 678.0, 221.0, 705.0, "boyamak için", 0.997], [66.0, 702.0, 249.0, 734.0, "encümeni teşkil", 0.988], [66.0, 729.0, 285.0, 761.0, "ettirtti ve içimizden", 0.99], [69.0, 760.0, 272.0, 787.0, "üç kişi koydurttu.", 0.982], [68.0, 787.0, 277.0, 814.0, "Fakat o zamandan", 1.0], [66.0, 811.0, 268.0, 843.0, "daha istediklerini", 0.999], [68.0, 842.0, 278.0, 868.0, "encümene söylerdi", 1.0], [68.0, 868.0, 267.0, 895.0, "ve istemediklerini", 1.0], [67.0, 896.0, 302.0, 923.0, "göstermez, müşavir-i", 0.984], [65.0, 919.0, 745.0, 957.0, "hassi olan paşa ile istişare ederlerdi. Her gelen mektuplardan", 0.98], [65.0, 946.0, 699.0, 985.0, "encümenin haberi olmazdi. Bu vekâletler ve bizden aldiği", 0.977], [65.0, 974.0, 699.0, 1010.0, "kuvvetler ile “Ben tekmil ailenin reisi ve vekiliyim” diyerek", 0.988], [65.0, 1001.0, 793.0, 1040.0, "Jeffersson-Cohn grubuyla mukavele yapti ve bu grubun çalişmasi", 0.98], [66.0, 1029.0, 762.0, 1066.0, "üzerine Sultan Abdülhamid evlädlarinin işlerine sekte vuruldu.", 0.981], [65.0, 1055.0, 798.0, 1093.0, "Malûmunuz üzre bu grup üç seneye yakin avans verdi. Bu paralar", 0.988], [65.0, 1083.0, 754.0, 1119.0, "Sultan Mahmud, Mecid, Aziz denmeyerek ailenin muhtacînine", 0.995], [65.0, 1110.0, 792.0, 1147.0, "tevzi olundu ve haksizlik yapilmadiği için almayanlar da ağizlarini", 0.975], [66.0, 1138.0, 745.0, 1174.0, "açmadilar. O zaman haksizlik yapilmamasinin sebebini şimdi", 0.995], [64.0, 1191.0, 792.0, 1230.0, "bu onlarin şerefi imiş. Onlarin bulunmasiyla şimdiki gibi uğursuz", 0.976], [65.0, 1220.0, 728.0, 1255.0, "miras kelimesi, fitne ve fesad tohumlari eklemeyerek, zehirli", 0.99], [65.0, 1246.0, 747.0, 1281.0, "bombalar atilmayarak herkesin malûmati tahtinda meydanda", 0.996], [65.0, 1274.0, 766.0, 1309.0, "sulh, samimiyet ve vicdan dairesinde bu i yapilmiş ve kimseler", 0.981]]}
