402.0, 325.0, 426.0, "5", 1.0], [413.0, 403.0, 431.0, 423.0, "1", 0.997], [506.0, 401.0, 526.0, 425.0, "3", 1.0], [655.0, 402.0, 675.0, 425.0, "1", 0.999], [79.0, 428.0, 155.0, 456.0, "Akdeniz", 1.0], [255.0, 430.0, 275.0, 454.0, "8", 1.0], [357.0, 429.0, 378.0, 454.0, "3", 1.0], [465.0, 431.0, 481.0, 453.0, "1", 0.998], [508.0, 430.0, 525.0, 452.0, "1", 0.999], [547.0, 426.0, 571.0, 455.0, "3", 1.0], [655.0, 429.0, 675.0, 454.0, "1", 0.978], [74.0, 480.0, 688.0, 503.0, "Not: Şu şekilde okunmalidir: Balkanlar'da doğan 46 görevliden 14'ü mesleğe Istanbul'da", 0.979], [72.0, 500.0, 137.0, 525.0, "başliyor.", 0.837], [101.0, 529.0, 689.0, 559.0, "Üç büyük bölge arasindaki ortak nokta, evlatlarinin çoğu-", 0.969], [75.0, 560.0, 689.0, 586.0, "nu kendilerinin eğitmeleri, bunlarin dörtte birini veya üçte birini", 0.996], [74.0, 586.0, 689.0, 614.0, "Istanbul'a göndermeleri ve neredeyse hiçbirini bir başka büyük", 0.988], [75.0, 616.0, 687.0, 642.0, "bölgeye göndermemeleridir. Demek oluyor ki bölgesel özerklik,", 0.986], [74.0, 644.0, 688.0, 672.0, "taşra/stanbul arasi hareketliliğin ağirliğı, bölgeler arasi hareketlili-", 0.967], [75.0, 672.0, 688.0, 700.0, "gin zayıf oluşu 19. yüzyil Osmanli idaresinin önemli özellikleridir.", 0.968], [73.0, 700.0, 689.0, 730.0, "Buna ilaveten, Ortadoğu imparatorluğun diğer iki büyük bölge-", 0.987], [75.0, 731.0, 688.0, 757.0, "sinden ayrilir: Bu bölgeden çıkan gençler diğer bölgelere kiyasla", 0.984], [75.0, 757.0, 688.0, 785.0, "daha büyük oranda memleketlerinde kalirlar,29 daha düşük oran-", 0.965], [76.0, 787.0, 689.0, 813.0, "da Istanbul'a giderler; imparatorluğun diğer bölgelerine hareket-", 0.99], [74.0, 814.0, 690.0, 843.0, "lilik de daha azdir. Arap bölgeleri Istanbul'a ve imparatorluğun", 0.993], [76.0, 845.0, 688.0, 871.0, "diğer bölgelerine Balkanlar'dan daha az açılir.30 Bu perspektifte II.", 0.977], [75.0, 871.0, 690.0, 901.0, "Abdülhamid'in Filistin, Suriye ve Irak’1 Osmanli nizamina katma", 0.97], [73.0, 900.0, 690.0, 929.0, "girişimlerini anlamak mümkündür. I. Dünya Savaşi'ndan çıkilir-", 0.952], [74.0, 929.0, 690.0, 957.0, "ken bu bölgelerin kaybedilmesinin, insan kaynaklari açisindan", 0.986], [74.0, 955.0, 690.0, 985.0, "1875-1877 ve 1912'deki Balkan savaşlari sonrasi Avrupa'daki", 0.976], [75.0, 988.0, 689.0, 1014.0, "topraklarin kaybedilmesi kadar dramatik sonuçlari olmadiği da", 0.988], [76.0, 1016.0, 688.0, 1042.0, "vurgulanmalidir. Bu noktayi Osmanli sonrasi milliyetçiliklerle ilgi-", 0.989], [74.0, 1043.0, 391.0, 1072.0, "lenenlerin dikkatine birakiyorum.", 0.994], [74.0, 1094.0, 106.0, 1118.0, "29", 1.0], [109.0, 1094.0, 589.0, 1119.0, "J. Szyliowicz de aym olguyu tespit ediyor (“Changes\", a.g.m., s. 263).", 0.969], [74.0, 1115.0, 106.0, 1139.0, "30", 1.0], [111.0, 1116.0, 630.0, 1139.0, "Bu 16. yüzyilda bile böyleydi. Bu bilgi için B. Lelouch'a teşekkür ediyorum.", 0.962]]}
