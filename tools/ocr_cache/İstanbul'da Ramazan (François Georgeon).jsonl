{"page": 201, "w": 907, "h": 1359, "lines": [[6.0, 15.0, 48.0, 42.0, "188", 0.948], [84.0, 18.0, 258.0, 44.0, "ISTANBUL'DA RAMAZAN", 1.0], [119.0, 123.0, 822.0, 154.0, "Davulcunun Istanbul'da, en azindan kentin belli başli mahal-", 0.976], [86.0, 158.0, 823.0, 188.0, "lelerinde ne zaman ve nasil ortadan kalktiğini tam olarak bilmi-", 0.992], [87.0, 192.0, 824.0, 222.0, "yoruz. Görüldüğü kadariyla resmen yasaklanmadi ama bu âdet", 0.99], [88.0, 225.0, 824.0, 256.0, "1930'larda Ramazan etkinlikleri umuma açık mahallerden özel", 0.983], [87.0, 259.0, 824.0, 291.0, "alanlara yönelince, Türkiye’nin büyük kentlerinde yavaş yavaş or-", 0.986], [89.0, 295.0, 824.0, 326.0, "tadan kalkmiş olmali. Osmanli’nin eski başkentinden silinip gitme-", 0.973], [87.0, 327.0, 823.0, 358.0, "si Ramazan’in siradan bir ay halini almasina katkida bulunmuştur.", 0.995]]}
