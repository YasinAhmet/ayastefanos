.984], [135.0, 1041.0, 708.0, 1061.0, "kadar olumlu etki yapacağı, bunun hangi tedbirlerle giderileceği gibi bir çok etkenler", 0.985], [133.0, 1059.0, 709.0, 1083.0, "etralca düşünülmemişti. Bu etkenler değerlendirilseydi gerek demiryollari ve gerek-", 0.977], [133.0, 1080.0, 709.0, 1104.0, "se denizyollari iletmesinde kilit personel, genellikle Rumlardan oluştuğuna göre,", 0.961], [136.0, 1102.0, 708.0, 1122.0, "bunlarin yönettikleri iletmelerin Türk Ordusu için ne kadar zararl sonuçlar vere-", 0.99], [133.0, 1120.0, 705.0, 1145.0, "ceği belirecekti.\", Yaşar ve Kabasakal, Türk Silabls Kuvvetleri Taribi.., s. 70s-707.", 0.956]]}
