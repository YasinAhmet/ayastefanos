{"page": 25, "w": 838, "h": 1193, "lines": [[470.0, 49.0, 753.0, 71.0, "OSMANLI AVRUPASI'NIN COGRAFI DURUMU 13", 0.967], [133.0, 562.0, 707.0, 585.0, "Ikinci Ordu Köprücü Bölükleri tarafindan Meriç Nebri üzerine 45 dakikada kurulan", 0.989], [183.0, 584.0, 656.0, 608.0, "tombaz köprü (ATASE Arivi, Balkan Harbi Albümü 1, Fotoğraf 84).", 0.984], [139.0, 629.0, 727.0, 658.0, "Ustruma Nehri: Sofya yakinlarinda Vitoş (Vitoşa) Dağl’ndan", 0.952], [112.0, 657.0, 727.0, 686.0, "çıkar, Orfani Körfezi’ne dökülür. Uzunluğu 250 km, genişliği 60-", 0.98], [111.0, 684.0, 727.0, 715.0, "90-150 m, en kurak mevsimde bile 30 metredir. Yataği çoğunlukla", 0.971], [112.0, 714.0, 727.0, 744.0, "çamur, pek az yeri kumluktur. Köstendil'den ağzina kadar, 15 ka-", 0.988], [113.0, 745.0, 651.0, 771.0, "rayolu, 1 demiryolu köprüsü vardır. Her mevsim engeldir.", 0.976], [140.0, 771.0, 727.0, 800.0, "Vardar Nehri: Şar Dağl’ndan çıkar, Selânik Körfezi’ne dökülür.", 0.974], [113.0, 800.0, 727.0, 829.0, "310 km uzunluğunda, 1,5-1,8 m derinliğinde ve 180-200 m geni-", 0.992], [113.0, 829.0, 727.0, 858.0, "liğindedir. Yukari kismi çakil ve taşlik, aşaği kisimlari kumludur.", 0.953], [114.0, 858.0, 726.0, 885.0, "Orta ve aşaği kisimlari üzerinde 11 karayolu ve 7 demiryolu köp-", 0.983], [112.0, 885.0, 426.0, 913.0, "rüsü vardir. Her mevsim engeldir.", 0.986], [140.0, 915.0, 727.0, 941.0, "Incekarasu (Ali Akman) Nehri: Prespa Gölü’nden çıkar, Selânik", 0.968], [111.0, 941.0, 729.0, 972.0, "Körfezi’ne dökülür. Pondus ve Olimpos dağlarini ayırır. Olimpos", 0.967], [114.0, 972.0, 727.0, 999.0, "Dağr’nin batisindan itibaren engeldir. Orta ve aşaği kisimlari 60-", 0.96], [115.0, 1002.0, 727.0, 1028.0, "100 m genişlikte ve 1,5-2 m derinliktedir. Aşaği ve orta kesimlerin-", 0.978], [113.0, 1028.0, 728.0, 1057.0, "de 7 karayolu köprüsü vardir. Yukari kesimleri taşli ve çakil, aşağı", 0.979], [113.0, 1056.0, 577.0, 1085.0, "kesimleri ise çamurludur. Önemli ölçüde engeldir.", 0.987], [142.0, 1085.0, 728.0, 1111.0, "Kösten (Pinios) Nehri: Pindus Dağlari’ndan çıkip, Selânik Kör-", 0.972], [115.0, 1111.0, 542.0, 1141.0, "fezi’ne dökülür, Yenişehir'den aşağısi engeldir.", 0.941]]}
