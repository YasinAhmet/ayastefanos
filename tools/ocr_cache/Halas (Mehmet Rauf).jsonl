{"page": 277, "w": 707, "h": 1286, "lines": [[54.0, 73.0, 669.0, 111.0, "TÜRK EDEBIYATI KLASIKLERI - 39", 0.924], [53.0, 137.0, 600.0, 162.0, "Halas Mehmet Rauf'un kaleme aldiği son romandir. Konusunu istiklal", 0.987], [51.0, 164.0, 676.0, 189.0, "Savaşi’ndan alan eser özellikle izmir’in Yunanlilar tarafindan işgalinin anlatildiği", 0.956], [51.0, 191.0, 634.0, 216.0, "ve şehrin bu yillardaki sosyal yaşamindan kesitler aktaran bölümleriyle ilgi", 0.977], [52.0, 219.0, 671.0, 241.0, "çekicidir. Hayatinin son döneminde vücudunun sağ tarafina inen felç nedeniyle", 0.99], [51.0, 270.0, 427.0, 296.0, "heyecanli ve bazen öfkeli bir üslup kullanmiştir.", 0.982], [290.0, 321.0, 574.0, 347.0, "Mehmet Rauf (1875-1931)", 1.0], [290.0, 354.0, 659.0, 382.0, "istanbul'da doğan Mehmet Rauf, Soğukçeşme", 0.982], [290.0, 383.0, 632.0, 408.0, "Askeri Rüştiyesi'ni bitirdikten sonra Bahriye", 0.987], [290.0, 410.0, 669.0, 432.0, "Mektebi'nde okudu. Staj için bir buçuk yil Girit'te", 0.972], [288.0, 434.0, 636.0, 460.0, "kaldi, daha sonra görevli olarak Almanya'ya", 0.987], [290.0, 462.0, 624.0, 487.0, "gönderildi. istanbul’a dönünce Tarabya'da", 0.971], [290.0, 490.0, 637.0, 512.0, "bulunan elçilik gemilerinin irtibat subayliğina", 0.984], [291.0, 517.0, 687.0, 539.0, "atandi. II. Meşrutiyet'in ilanindan sonra askerlikten", 0.965], [290.0, 543.0, 662.0, 567.0, "ayrildi ve geçimini yazarlikla sağlamaya çalişti;", 0.993], [289.0, 568.0, 667.0, 593.0, "hikâye, roman, tiyatro gibi türlerde pek çok eser", 0.985], [289.0, 595.0, 630.0, 619.0, "verdi. Mehasin ve Süs adli kadin dergilerini", 0.996], [289.0, 622.0, 676.0, 647.0, "çikardi. Bir süre ticaretle uğraştiysa da son yillari", 0.979], [287.0, 647.0, 513.0, 674.0, "maddi sikintilar içinde geçti.", 0.984], [51.0, 675.0, 681.0, 699.0, "Henüz on alti yaşındayken yazdiği ve Halit Ziya Uşakligil’e Hizmet gazetesinde", 0.971], [51.0, 703.0, 674.0, 725.0, "yayimlamasi için gönderdiği “Düşmüş” adli hikâyeyle edebiyat dünyasina girdi.", 0.966], [49.0, 726.0, 683.0, 752.0, "Daha sonra Mektep dergisinde yazdi. Servet-i Fünun dergisinde hikâye, roman,", 0.997], [51.0, 756.0, 336.0, 778.0, "makale ve mensur şiirler yayimladi.", 0.955], [51.0, 782.0, 662.0, 804.0, "Mehmet Rauf asil şöhretini Eylül adli romaniyla kazandi. Türk edebiyatinda", 0.985], [50.0, 808.0, 584.0, 832.0, "psikolojik romanin ilk başarili örneği kabul edilen Eylüľde Fransiz", 0.981], [50.0, 836.0, 643.0, 858.0, "romaninda çok yaygin olan ak üçgeni ele alinmitir. Ruh çözümlemeleri", 0.986], [49.0, 886.0, 661.0, 912.0, "Mehmet Rauf'un diğer Edebiyat-1 Cedide yazarlarina göre daha akici bir dil", 0.978], [49.0, 914.0, 289.0, 939.0, "kullanmasinin payı büyüktür.", 0.975], [50.0, 941.0, 643.0, 965.0, "Hikâye ve romanlarinda aşk, istirap, arayiş, ihtiras gibi daha çok bireysel", 0.979], [50.0, 967.0, 655.0, 992.0, "duygulara eğilen ve Servet-i Fünun topluluğunun en meşhur yazarlarindan", 0.994], [48.0, 992.0, 630.0, 1018.0, "olan Mehmet Rauf'un eserlerine Türk Edebiyati Klasikleri Dizimizde yer", 0.986], [50.0, 1022.0, 232.0, 1044.0, "vermeyi sürdüreceğiz.", 0.999], [567.0, 1219.0, 628.0, 1251.0, "14 TL", 1.0], [51.0, 1231.0, 174.0, 1247.0, "9786257070379", 0.997]]}
