{"page": 185, "w": 707, "h": 1286, "lines": [[50.0, 22.0, 658.0, 51.0, "iki batarya ve Malatya’daki süvari alayi bunlara karşı sevk", 0.985], [50.0, 55.0, 170.0, 85.0, "olunmuştu.", 0.979], [82.0, 88.0, 659.0, 118.0, "Bu hazirliklari haber alan hainler Urfa üzerinden Halep’e", 0.981], [51.0, 122.0, 268.0, 150.0, "kaçtilar ve dağildilar.", 0.986], [83.0, 154.0, 657.0, 183.0, "Iş bu kerteye gelince Temsil Heyeti Istanbul’da padişaha", 0.954], [51.0, 188.0, 658.0, 216.0, "başvurarak kabinenin meşru olamadiğini ve iktidara meşru", 0.985], [50.0, 221.0, 658.0, 250.0, "bir heyet gelinceye kadar İstanbul'la görüşmeyi kestiklerini", 0.97], [50.0, 255.0, 658.0, 283.0, "açıkladilar. Bu tehdit sonucunda Ferit Paşa ve avenesi istifa-", 0.989], [49.0, 286.0, 224.0, 315.0, "ya mecbur kaldi.", 0.994], [84.0, 320.0, 658.0, 347.0, "Yeni Ali Riza Paşa kabinesi Temsil Heyeti'nin isteklerini", 0.981], [50.0, 352.0, 657.0, 381.0, "esas olarak kabul etmi ve ayrintilar üzerinde anlaşmak için", 0.989], [49.0, 387.0, 657.0, 415.0, "Bahriye Naziri Salih Paşa’yi Amasya’ya göndermiti. Orada", 0.98], [48.0, 416.0, 658.0, 450.0, "üç gün üç gece süren görüşmelerle kongrelerin kabul ve ilan", 0.986], [49.0, 452.0, 658.0, 480.0, "ettiği önemli maddeler tartiıldi ve kabul olundu. Yeniden se-", 0.984], [49.0, 485.0, 656.0, 515.0, "çim yapilip Milet Meclisi’nin toplanmasina da karar verildi.", 0.983], [83.0, 517.0, 658.0, 546.0, "Temsil Heyeti meclisin Anadolu’da toplanmasini arzu", 0.993], [50.0, 550.0, 657.0, 579.0, "ediyordu. Fakat Istanbul’dakiler, “Bu siyaseten doğru değil-", 0.986], [48.0, 581.0, 658.0, 613.0, "dir,” diye israr ettiklerinden meclis seçildiği vakit Istanbul'da", 0.976], [49.0, 617.0, 657.0, 645.0, "toplandi ve Sivas’ta tekrar edilen Misakimilli mecliste resmi-", 0.985], [46.0, 647.0, 658.0, 679.0, "lik kazanarak Türklerin asgari istekleri olmak üzere dünya-", 0.992], [48.0, 682.0, 205.0, 711.0, "ya ilan olundu.", 0.99], [80.0, 713.0, 658.0, 745.0, "Işte bu siradadir ki Mustafa Kemal Paşa ve Temsil Heyeti", 0.969], [49.0, 748.0, 242.0, 777.0, "Ankara’ya geldiler.", 0.987], [80.0, 814.0, 319.0, 843.0, "Nihat sözüne devamla:", 0.993], [80.0, 848.0, 657.0, 876.0, "— Ingilizler devamli Istanbul’a baski yapiyorlar ve uy-", 0.962], [48.0, 881.0, 655.0, 910.0, "gun bir bari elde etmek için Yunanlilara karşi Aydin'da", 0.974], [47.0, 914.0, 656.0, 942.0, "savaan ve Ankara’da hükmünü her tarafa yaydiran Ku-", 0.986], [49.0, 947.0, 657.0, 975.0, "vayimilliye’nin her durumda ortadan kaldirilmasinda israr", 0.993], [49.0, 980.0, 656.0, 1009.0, "ediyorlardi. Halbuki Kuvayimilliye hükmünü her cephede", 0.973], [47.0, 1011.0, 657.0, 1043.0, "yürütüyordu. Isteklerinin ve iddialarinın sonuçsuz kaldiğıni", 0.962], [48.0, 1046.0, 656.0, 1075.0, "görünce Ingilizler şaşirdilar, kudurdular ve ne yaptiklarini", 0.967], [48.0, 1078.0, 656.0, 1107.0, "bilmez gibi sonunda 16 Mart’ta Istanbul’u işgal ettiler. Işte", 0.97], [48.0, 1112.0, 655.0, 1140.0, "bu andan itibaren mücadele daha siki bir safhaya girerek Is-", 0.984], [47.0, 1145.0, 655.0, 1173.0, "tanbul Anadolu’ya karşı maskesini atti ve kanli bir boğuşma", 0.978], [45.0, 1178.0, 174.0, 1207.0, "ortaya çıkti.", 0.923], [330.0, 1244.0, 369.0, 1271.0, "173", 1.0]]}
{"page": 273, "w": 707, "h": 1286, "lines": [[124.0, 83.0, 582.0, 115.0, "TÜRK EDEBIYATI KLASIKLERI DIZISI", 0.986], [48.0, 187.0, 423.0, 214.0, "1. KUYRUKLUYILDIZ ALTINDA BÍR IZDIVAÇ", 0.973], [88.0, 222.0, 285.0, 248.0, "Hüseyin Rahmi Gürpinar", 0.99], [46.0, 273.0, 193.0, 301.0, "2. MÜREBBIYE", 0.991], [87.0, 309.0, 286.0, 335.0, "Hüseyin Rahmi Gürpınar", 0.99], [48.0, 365.0, 85.0, 387.0, "3.", 1.0], [85.0, 364.0, 230.0, 387.0, "EFSUNCU BABA", 1.0], [87.0, 397.0, 285.0, 423.0, "Hüseyin Rahmi Gürpinar", 0.983], [47.0, 451.0, 88.0, 476.0, "4.", 1.0], [79.0, 449.0, 165.0, 476.0, "INTIBAH", 0.914], [87.0, 484.0, 203.0, 507.0, "Namik Kemal", 0.978], [46.0, 537.0, 235.0, 565.0, "5. $AÍR EVLENMESI", 0.912], [85.0, 569.0, 140.0, 597.0, "Sinasi", 0.985], [46.0, 625.0, 290.0, 651.0, "6. VATAN YAHUT SILÍSTRE", 0.955], [87.0, 657.0, 203.0, 683.0, "Namik Kemal", 0.967], [46.0, 712.0, 220.0, 738.0, "7. KÜÇÜK $EYLER", 0.956], [87.0, 746.0, 261.0, 772.0, "Samipaazade Sezai", 1.0], [49.0, 802.0, 90.0, 824.0, "8.", 0.999], [83.0, 800.0, 360.0, 825.0, "FELÂTUN BEY ILE RÂKIM EFENDÍ", 0.985], [86.0, 832.0, 252.0, 857.0, "Ahmet Mithat Efendi", 0.999], [45.0, 886.0, 563.0, 913.0, "9. TAAŞSUK-I TALAT VE FITNAT -TALAT VE FITNAT'IN AŞKI-", 0.957], [86.0, 921.0, 211.0, 947.0, "Semsettin Sami", 0.992], [49.0, 975.0, 213.0, 1000.0, "10. MAÍ VE SIYAH", 0.926], [86.0, 1009.0, 240.0, 1034.0, "Halit Ziya Uakligil", 0.999], [48.0, 1064.0, 140.0, 1087.0, "11. REFET", 0.999], [86.0, 1097.0, 185.0, 1123.0, "Fatma Aliye", 0.999], [48.0, 1151.0, 377.0, 1176.0, "12. TURFANDA MI YOKSA TURFA MI?", 0.957], [86.0, 1186.0, 210.0, 1208.0, "Mizanci Murat", 0.999], [329.0, 1244.0, 369.0, 1270.0, "261", 1.0]]}
