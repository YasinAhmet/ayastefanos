{"page": 24, "w": 883, "h": 1319, "lines": [[170.0, 610.0, 323.0, 634.0, "Atatürk'ün babast", 0.951], [216.0, 633.0, 324.0, 660.0, "Ali Riza Bey", 0.981], [124.0, 693.0, 728.0, 722.0, "sadece mektebe başlama töreni yapmakla yerine getiri-", 0.993], [123.0, 722.0, 728.0, 752.0, "liyor. Baba ise, oğlunu ertesi gün, yeni tarz mektebe", 0.996], [122.0, 752.0, 729.0, 782.0, "kaydettiriyor. Fakat ne yazik ki memuriyetten ayrilarak", 0.981], [121.0, 782.0, 728.0, 812.0, "kereste ticareti yapan genç baba, oğlunun okumasina", 0.992], [121.0, 810.0, 349.0, 840.0, "tanik olamayacaktir.", 0.978], [153.0, 836.0, 729.0, 871.0, "Mustafa, daha ilkokul çağinda babadan yetim kal-", 0.977], [122.0, 869.0, 730.0, 899.0, "mitir. Ancak öğretim düşüncesi devam ediyor, O her", 0.965], [119.0, 895.0, 730.0, 930.0, "şeye rağmen okuyor, 1893'te Selanik'teki Askeri Rüti-", 0.972], [119.0, 924.0, 731.0, 958.0, "ye'ye sinay vererek giriyor. Burada matematik öğretme-", 0.986], [119.0, 952.0, 730.0, 986.0, "ni Mustafa Efendi, öğrencisinin yetenek ve yetkinliğine", 0.988], [121.0, 983.0, 728.0, 1013.0, "hayran olduğu için, ona Kemal adini veriyor. Mustafa", 0.982], [121.0, 1012.0, 728.0, 1043.0, "Kemal 1895'te, ilk defa doğduğu şehirden çıkarak, Ma-", 0.986], [121.0, 1042.0, 728.0, 1072.0, "nastir Askeri Lisesi'ne yatili öğrenci olarak giriyor. Ora-", 0.963], [121.0, 1070.0, 727.0, 1100.0, "da şiir ve edebiyata merak saryor. Tatil zamanlarinda", 0.992], [121.0, 1098.0, 728.0, 1128.0, "ise Selanik'teki Frerler Okulu'nda Fransizcasini ilerleti-", 0.982], [120.0, 1126.0, 728.0, 1159.0, "yor. Mart 1899'da Mustafa Kemal'i Istanbul Harp", 0.985], [120.0, 1154.0, 730.0, 1188.0, "Okulu'nun piyade sinifinda kayitli buluyoruz. O, bir", 0.985], [710.0, 1234.0, 729.0, 1259.0, "5", 0.951]]}
{"page": 29, "w": 742, "h": 1177, "lines": [[395.0, 450.0, 559.0, 505.0, "1911 -", 0.859], [454.0, 501.0, 575.0, 521.0, "Officiers étrangees", 0.952], [76.0, 531.0, 667.0, 557.0, "Mustafa Kemal ve Fethi Okyar (solunda) Picardie manevralari sirasinda", 0.986], [66.0, 571.0, 675.0, 604.0, "larindaki direniş hareketlerini yönetmiştir. Ekim", 0.968], [65.0, 601.0, 677.0, 636.0, "1912'de Balkan Savaşinin ilan edildiğini işitince, Avru-", 0.97], [66.0, 631.0, 675.0, 665.0, "pa yoluyla Romanya üzerinden Istanbul'a dönmüştür.", 0.978], [67.0, 661.0, 676.0, 694.0, "Gelibolu yarimadasini korumak için kurulan Bolayır", 0.965], [66.0, 689.0, 676.0, 723.0, "Kolordusu’nun kurmay başkani sifatiyla bu kumandan-", 0.98], [68.0, 722.0, 676.0, 752.0, "lik görevini üzerine almiş ve bundan sonra Edirne'nin", 0.979], [68.0, 751.0, 374.0, 780.0, "geri alinışında bulunmuştur.", 0.946], [101.0, 780.0, 676.0, 810.0, "Tam bir sene sonra, Sofya merkez olmak üzere, Bük-", 0.984], [69.0, 811.0, 676.0, 841.0, "reş, Belgrat ve Çetine ataşemiliterliklerinde görev almış-", 0.968], [69.0, 840.0, 677.0, 870.0, "tir (27 Ekim 1913-2 Şubat 1915 tarihleri arasinda). Bi-", 0.963], [67.0, 867.0, 679.0, 901.0, "rinci Dünya Savaşina katilan Osmanli ordusunda, fii-", 0.966], [67.0, 896.0, 679.0, 931.0, "len çalşmak istediğini bildirmesi üzerine, Gelibolu Yari-", 0.984], [69.0, 927.0, 677.0, 960.0, "madas’ndaki 19. Tümen Kumandanliği’na getirilmitir.", 0.963], [68.0, 956.0, 679.0, 990.0, "18 Mart 1915'te Çanakkale Boğazi’ni geçmeyi başara-", 0.964], [68.0, 985.0, 680.0, 1019.0, "mayan Itilaf kuvvetleri, Gelibolu yarimadasinin batisina", 0.974], [68.0, 1015.0, 677.0, 1049.0, "asker çıkarmak istemişlerdir (25 Nisan 1915). Işte M.", 0.964], [69.0, 1045.0, 679.0, 1079.0, "Kemal, Ariburnu'nun Anafartalar kisminda emrindeki", 0.982], [70.0, 1122.0, 98.0, 1149.0, "10", 1.0]]}
{"page": 160, "w": 788, "h": 1173, "lines": [[77.0, 480.0, 684.0, 505.0, "Sivas Kongresine katilan temsilciler Mustafa Kemal'le birlikte. Fotoğrafta", 0.985], [98.0, 505.0, 666.0, 531.0, "yer alanlar arasmnda Mazhar Müfit Kansu, Bekir Sami Kunduh, Rauf", 0.983], [108.0, 532.0, 652.0, 555.0, "Orbay, Recep Zühtü, Hüsrev Gerede, Ruşen Eşref Ünaydin vardır.", 0.961], [109.0, 582.0, 683.0, 611.0, "Temmuz 1919'da Mustafa Kemal, bütün askeri si-", 0.976], [74.0, 613.0, 682.0, 643.0, "fatlarini terk etmiş ve Istanbul Hükümeti'ne istifasini", 0.958], [74.0, 643.0, 682.0, 676.0, "bildirmiştir. Eylül'de Sivas Kongresi'nin başkanı, doğu", 0.967], [72.0, 673.0, 680.0, 706.0, "ve bati vilayetlerinde kurulmuş olan ulusal kuruluşlari,", 0.974], [71.0, 703.0, 679.0, 737.0, "ülkeyi kurtarma fikri etrafinda toplamaya başlamıştir.", 0.971], [71.0, 733.0, 680.0, 767.0, "1919'un son ayinda Ankara'ya gelir. 1920 yilinda ise", 0.976], [72.0, 766.0, 678.0, 796.0, "ülkede yer yer yapilan mücadeleleri, birleştirici-bir fikir", 0.974], [70.0, 797.0, 384.0, 826.0, "etrafinda toplanmaya başlar.", 0.993], [100.0, 824.0, 676.0, 857.0, "Şimdi 1920 ile 1923 yillari arasindaki zamanda,", 0.971], [68.0, 853.0, 677.0, 888.0, "Türkiyeye bakalim: Maddi kuvvet, başlangiçta, yani", 0.976], [69.0, 884.0, 676.0, 916.0, "1920'de hemen hiç yok gibidir. Fakat 1922 yilinın Ey-", 0.972], [68.0, 914.0, 674.0, 944.0, "lül ayında düşman ordularini denize dökecek bir du-", 0.975], [64.0, 941.0, 675.0, 975.0, "ruma gelinmiştir. Kuvvetler, belki sayica ya da malze-", 0.979], [66.0, 973.0, 672.0, 1003.0, "me olarak üstün değildir, fakat düzenli örgüt haline", 0.99], [65.0, 1003.0, 671.0, 1032.0, "gelen ülke kuvvetleri, yüksek başkumandan ve değerli", 0.988], [62.0, 1029.0, 672.0, 1063.0, "kumandanlar tarafindan idare edilmiştir. Siyasi duru-", 0.985], [627.0, 1118.0, 670.0, 1148.0, "141", 1.0]]}
{"page": 292, "w": 753, "h": 1170, "lines": [[154.0, 444.0, 604.0, 469.0, "Afet Inan 1937'de Dolmababçe Sarayinda düzenlenen", 0.982], [260.0, 468.0, 495.0, 491.0, "II. Türk Tarih Kongresinde.", 0.955], [107.0, 518.0, 501.0, 548.0, "Atatürk, 1 Kasim 1937'de diyor ki:", 0.981], [157.0, 576.0, 679.0, 607.0, "Türk Tarih ve Dil kurumlarinin, Türk milli varliğini aydinla-", 0.977], [119.0, 607.0, 678.0, 635.0, "tan çok kiymetli ve önemli birer ilim kurumu mahiyetini aldiği-", 0.992], [117.0, 634.0, 678.0, 665.0, "ni görmek hepimizi sevindirici bir hadisedir. Tarih Kurumu,", 0.988], [115.0, 662.0, 679.0, 697.0, "yaptiğ kongre, kurduğu sergi, yurt içindeki hafirler [kazilar]", 0.967], [117.0, 694.0, 676.0, 723.0, "ortaya çikardiğ eserlerle simdiden bütün ilim dünyasina kül-", 0.961], [117.0, 723.0, 651.0, 752.0, "türel vazifesini ifaya [yerine getirmeye] başlamiş bulunuyor.", 0.976], [103.0, 781.0, 675.0, 810.0, "Atatürk'ün bahsettiği kongre, Türk Tarih Kuru-", 0.992], [67.0, 809.0, 674.0, 840.0, "mu'nun 1937'de Istanbul’da toplanan ikinci kongresi", 0.962], [63.0, 836.0, 112.0, 871.0, "idi.", 0.999], [99.0, 868.0, 673.0, 900.0, "Türk Tarih Kurumu’nun kuruluşunun 25. yilinda", 0.967], [64.0, 896.0, 673.0, 930.0, "ise V. Kongresi toplanmıştir. Tarih Kurumu kuruluş", 0.957], [65.0, 928.0, 673.0, 958.0, "seneleri ile hesaplanan yaşta bulunan gençler bu kon-", 0.994], [63.0, 956.0, 672.0, 986.0, "grenin dinleyicileri arasina katildilar. Türk Tarih Ku-", 0.996], [64.0, 986.0, 671.0, 1016.0, "rumu’nun fikir hareketi neticesinde çeşitli sahalarda", 0.987], [62.0, 1016.0, 670.0, 1045.0, "yetişmiş uzmanlar ise bu kongremizin çalişmalarinda", 0.973], [60.0, 1043.0, 672.0, 1076.0, "görev almişlardir. Herkes kendi sahasinda bir yenilik", 0.97], [629.0, 1114.0, 673.0, 1144.0, "273", 1.0]]}
{"page": 317, "w": 754, "h": 1168, "lines": [[119.0, 456.0, 632.0, 483.0, "1936'daki III. Türk Dil Kurultayinda Atatürk, katilimcilar ve", 0.968], [255.0, 481.0, 494.0, 507.0, "Af et Inan'la sohbet ederken.", 0.955], [106.0, 534.0, 680.0, 565.0, "Türk Tarih Kurumu ikinci Dil Kurultayinda da", 0.972], [70.0, 563.0, 681.0, 597.0, "şunu demişti: “Bu kürsü, önünde ateş yakilan bir", 0.971], [72.0, 593.0, 204.0, 626.0, "mihraptir.\"", 0.968], [107.0, 625.0, 245.0, 656.0, "Arkadaşlar;", 0.992], [107.0, 654.0, 682.0, 684.0, "Asırlik işleri yillara siğdiran Türk inkilabi, kendi", 0.961], [73.0, 681.0, 683.0, 716.0, "mihrabinin, bizzat Güneş olduğunu bulmuştur. Tarih", 0.983], [75.0, 714.0, 684.0, 743.0, "yolculuğunda Güneş'in ilham izlerine, en çok biz", 0.981], [76.0, 741.0, 684.0, 772.0, "Türkler tesadüf ediyoruz. Türk irki kültürünü öyle", 0.968], [77.0, 771.0, 684.0, 801.0, "bir yerde buldu ki, orada Güneş ona en verimli oldu.", 0.996], [74.0, 797.0, 686.0, 832.0, "Ilk yurttan ayrilmaya mecbur olan Türkler, başlica", 0.971], [75.0, 826.0, 686.0, 862.0, "göç yollari için yine Güneş’in kilavuzluğundan istifa-", 0.964], [77.0, 859.0, 188.0, 889.0, "de ettiler.", 1.0], [109.0, 886.0, 687.0, 921.0, "Doğu ve Bati ellerine yayildilar; o geniş ülkelerde,", 0.957], [78.0, 917.0, 620.0, 948.0, "yüksek varliklarinın ebedi vesikalarini biraktilar.", 0.969], [114.0, 946.0, 687.0, 976.0, "Öz yurdumuz Anadolu'nun ilk kültürünü kuran", 0.992], [80.0, 976.0, 690.0, 1007.0, "cetlerimiz [atalarimiz], Güneş’i sembolize ettiler. Onu", 0.983], [79.0, 1005.0, 689.0, 1036.0, "sanatlarinin inceliklerinde mevzu aldilar. Türk Tarih", 0.981], [81.0, 1035.0, 689.0, 1066.0, "Kurumu’nun Alacahöyük’te yaptiği hafriyatta bulun-", 0.971], [81.0, 1112.0, 122.0, 1141.0, "298", 1.0]]}
{"page": 464, "w": 780, "h": 1260, "lines": [[98.0, 110.0, 660.0, 144.0, "hatta hiyanet icinde bulunabilirler. Hatta bu iktidar sahipleri", 0.96], [98.0, 137.0, 660.0, 175.0, "şahsi menfaatlerini, müstevlilerin siyasi emelleriyle tevhit ede-", 0.963], [99.0, 168.0, 658.0, 201.0, "bilirler. Millet, fakr u zaruret içinde harap ve bitap düşmüş ola-", 0.982], [96.0, 196.0, 147.0, 230.0, "bilir.", 1.0], [138.0, 225.0, 382.0, 258.0, "Ey Türk istikbalinin evlâd!", 0.97], [140.0, 255.0, 660.0, 286.0, "işte; bu ahval ve şerait icinde dahi vazifen, Türk istikläl ve", 0.974], [103.0, 286.0, 660.0, 316.0, "Cumhuriyetini kurtarmaktir. Muhtaç olduğun kudret, damarla-", 0.972], [103.0, 315.0, 378.0, 342.0, "rindaki asil kanda, mevcuttur!\"", 0.993], [377.0, 549.0, 411.0, 567.0, "× *", 0.86], [378.0, 563.0, 405.0, 578.0, "×", 0.707], [180.0, 623.0, 535.0, 662.0, ".", 0.55], [274.0, 1032.0, 407.0, 1066.0, "1e", 0.603], [160.0, 1069.0, 567.0, 1113.0, "Atatürk’ün Gençliğe Hitabesi'nin müsveddesi. ", 0.961], [629.0, 1178.0, 671.0, 1206.0, "445", 0.997]]}
{"page": 523, "w": 822, "h": 1177, "lines": [[246.0, 119.0, 562.0, 164.0, "BESER TARIHINE", 0.951], [312.0, 191.0, 406.0, 226.0, "girg", 0.715], [150.0, 218.0, 640.0, 249.0, "Laak masiainsgaok bavatlarumuzda-", 0.714], [127.0, 241.0, 643.0, 271.0, "essesalarimizde hala gagamakte-oldugt-göralogos.", 0.746], [129.0, 266.0, 644.0, 292.0, "Bumammababi.va insanlasan-biriegip mtpbomedeble", 0.727], [130.0, 312.0, 640.0, 338.0, "cok.amlagalmadakcabugününganig-siyeek.iqimal,", 0.69], [129.0, 335.0, 641.0, 361.0, "iktand-mosalalarimi-ntamek güqts.Be-msihpiri-", 0.554], [120.0, 357.0, 644.0, 383.0, "0yemmeh icin insamereden sa-nas gedigi", 0.744], [127.0, 379.0, 575.0, 407.0, "palalevnda-del-idoaksaaibisamake-tèzwdos.", 0.505], [264.0, 403.0, 638.0, 428.0, "insanbugünü anla-", 0.941], [128.0, 426.0, 639.0, 452.0, "mak icin dünü bilmege; dünkn isleri kavramak", 0.972], [79.0, 436.0, 120.0, 462.0, "aln", 0.692], [127.0, 448.0, 639.0, 476.0, "icin, daha evvel geçmis günlerin, nihayet uzak", 0.976], [123.0, 472.0, 639.0, 498.0, "zamanlarm, vakalarin hatirlamaga mecbur oluyor.", 0.97], [129.0, 496.0, 638.0, 519.0, "Bu stretle, insan. icinde bulundugu vaziyetin,", 0.973], [126.0, 518.0, 638.0, 544.0, "lalerin, hakikt baslangicini anlamak istedikçe geri-", 0.925], [126.0, 539.0, 514.0, 565.0, "ye dogru cekildigini duyar. Mamm", 0.93], [368.0, 562.0, 638.0, 588.0, " hayanm-merkez yayla.", 0.825], [126.0, 586.0, 638.0, 611.0, "larmna ve oralarda cski zamaniarda yaçamig insan-", 0.952], [124.0, 608.0, 639.0, 634.0, "lara kadar gider. Fakat bu da kâfi gelmez; daha", 0.97], [125.0, 632.0, 639.0, 658.0, "geriye. ilk insanlara ve nihayet ilk hayata ve bu-", 0.989], [125.0, 654.0, 476.0, 680.0, "nun ilk belirdigi yere kadar iner.", 0.965], [122.0, 698.0, 647.0, 727.0, ".gubaden-birgaltalimheria,atbecanhge son-1oo", 0.701], [667.0, 706.0, 737.0, 739.0, "not", 0.849], [114.0, 721.0, 643.0, 750.0, "sene-narinda-heçiedebildikleri. poniget-sabasinda", 0.81], [123.0, 745.0, 639.0, 772.0, "vuku-bu