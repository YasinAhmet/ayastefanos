{"page": 63, "w": 1189, "h": 1560, "lines": [[254.0, 58.0, 915.0, 88.0, "MÜZELER, CANLANDIRMALAR VE KOLEKSIYONLAR", 0.993], [903.0, 299.0, 1093.0, 322.0, "Muharebede sivrllen ve", 0.996], [903.0, 323.0, 1126.0, 346.0, "yararlilik gösteren birllklere", 0.969], [902.0, 368.0, 1106.0, 394.0, "niganlar.\" Bunlar birimin", 0.929], [903.0, 394.0, 1105.0, 417.0, "sancağina raptedillyordu", 0.979], [903.0, 418.0, 1100.0, 441.0, "ve hepsl Hicri 1332-1333", 0.947], [902.0, 441.0, 1090.0, 464.0, "tarlhllydl, bu tarih 1915", 0.97], [903.0, 466.0, 1061.0, 489.0, "yilindakl Çanakkale", 0.989], [902.0, 488.0, 1095.0, 513.0, "seferlne denk gellyordu", 0.975], [903.0, 512.0, 1047.0, 536.0, "(yazarn fotoğraf,", 0.961], [903.0, 536.0, 1059.0, 560.0, "Çanakkale Müzesl).", 0.993], [56.0, 637.0, 144.0, 728.0, "O", 0.685], [132.0, 638.0, 578.0, 671.0, "smanli Imparatorlugu'nun I. Dünya", 0.977], [610.0, 641.0, 1124.0, 670.0, "ilçesinde bir Harp Müzesi mevcuttur. Yarimadanin", 0.985], [133.0, 668.0, 576.0, 700.0, "Savaşı'na katilmasindan geriye kalan obje-", 0.973], [610.0, 671.0, 1124.0, 699.0, "daha aşağisinda, Kilitbahir'deki eski Osmanli ka-", 0.962], [133.0, 697.0, 576.0, 729.0, "lerin sergilendiği en büyük müze hiç şüp-", 0.978], [610.0, 700.0, 1123.0, 730.0, "lesinde ilginç bir obje koleksiyonu bulunmaktadir.", 0.984], [61.0, 727.0, 577.0, 757.0, "hesiz Istanbul Harbiye'deki Askeri Müze'dir. Bu", 0.968], [610.0, 730.0, 1123.0, 759.0, "Bunlarin kimi savaş meydanlarinda bulunmuş, kd-", 0.951], [61.0, 759.0, 577.0, 788.0, "müzede ayrica önemli bir kütüphane ile fotograf", 0.972], [607.0, 759.0, 1122.0, 790.0, "mileri de gazilerya da şehit aileleri tarafindan bağş-", 0.969], [62.0, 789.0, 576.0, 818.0, "arşivi bulunmaktadir. Osmanli ordusunun bu sa-", 0.959], [608.0, 789.0, 1124.0, 818.0, "lanmıştir. I. Dünya Savaşi'ndan kalan objelerle ilgili", 0.956], [61.0, 818.0, 576.0, 849.0, "vaştaki diger yönleriyle ilgilenenler Beşiktaş'taki", 0.965], [608.0, 818.0, 1123.0, 849.0, "üçüncü bir koleksiyon, kisa bir feribot yolculuguyla", 0.979], [62.0, 849.0, 576.0, 878.0, "Deniz Müzesi ile Yeşilköy'deki Hava Kuvvetleri", 0.989], [610.0, 849.0, 1124.0, 878.0, "gidilen Çanakkale Kalesi'ndedir. Bazilari Suriye'de", 0.98], [63.0, 879.0, 361.0, 906.0, "Müzesi'ni ziyaret edebilirler.", 0.993], [608.0, 877.0, 1125.0, 908.0, "bulunan çeşitli müzelerde de I. Dünya Savaşı'na ait", 0.981], [95.0, 907.0, 576.0, 936.0, "Osmanlilarin I. Dünya Savaşı sirasindaki en an-", 0.972], [609.0, 908.0, 1124.0, 937.0, "diğer Osmanli askeri objeleri mevcuttur, ama bunlar", 0.981], [60.0, 936.0, 576.0, 968.0, "laml zaferini oluşturan Çanakkale savunmasinin ya-", 0.963], [608.0, 938.0, 1079.0, 969.0, "özel bir sergi alaninda bir araya toplanmamiştir.", 0.965], [62.0, 968.0, 576.0, 997.0, "pildign bölgede daha küçük ve uzmanlaşmış müzeler", 0.945], [643.0, 968.0, 1123.0, 997.0, "Bilindigi kadarryla, Osmanli askerinin I. Dünya", 0.965], [62.0, 998.0, 576.0, 1024.0, "bulunmaktadir. Deniz kenarindakt küçük Gelibolu", 0.975], [607.0, 998.0, 1122.0, 1027.0, "Savaşı'ndaki yaşami ve yaptiklari konusunda hiçbir", 0.935], [457.0, 1134.0, 732.0, 1165.0, "Ölü ve yaralilari kurtarmak", 0.981], [97.0, 1178.0, 1088.0, 1205.0, "Amerikal diplomat Lewis Einstein'a göre, Çanakkale cephesinde ölüleri gömmek için bir ateşkes yapilmişti. 5 Haziran", 0.982], [88.0, 1231.0, 1098.0, 1257.0, "öğrendim. Be günlük bir muharebenin ardindan her yer cesetlerle dolmuştu. Itilaf devletlerinin bulunduğu tarafa bir Kizil", 0.987], [89.0, 1256.0, 1095.0, 1283.0, "Haç bayraği çekilmişti, daha sonra da Türkler Hilal-i Ahmer bayrağ çektiler. Daha sonra bir Ingiliz subayi ōne çikti, ama", 0.972], [93.0, 1308.0, 1091.0, 1335.0, "da birbirini suçlayamazdi. Dokuz saatlik ateşkes boyunca Ingilizler serbestçe ortaya çıktilar, ama Türkler mevzilerini ve", 0.98], [97.0, 1335.0, 1087.0, 1362.0, "sayilarini belli etmemek için ortalikta fazla görünmediler. Türklerin topladiği yaralilardan bazilari beş gün aç kalmiş ve", 0.97], [101.0, 1362.0, 1083.0, 1388.0, "yaralari tedavi edilmemi olmasina karşin hâlã hayattaydilar.\" L. Einstein, Inside Constantinople: A Diplomat's Diary", 0.984], [284.0, 1388.0, 900.0, 1414.0, "During the Dardanelles Expedition April-September 1915 (Londra, 1917).", 0.992], [226.0, 1415.0, 956.0, 1440.0, "· O gün Türk tarafinin savaş alaninda sadece bir yarali bulabildigi, onun da hastaneye götürülürken öldügu söylenir.", 0.953], [1092.0, 1489.0, 1125.0, 1518.0, "61", 1.0]]}
