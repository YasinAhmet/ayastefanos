{"page": 5, "w": 688, "h": 1300, "lines": [[232.0, 189.0, 461.0, 224.0, "Vatan yahut Aşk", 0.991], [75.0, 294.0, 648.0, 322.0, "Namik Kemal’in tiyatrolarindan Vatan yabut Silistre,", 0.968], [42.0, 327.0, 648.0, 355.0, "yurtseverlik ve kahramanliğ konu edinmektedir. Oyun", 0.975], [43.0, 360.0, 648.0, 388.0, "1853 Osmanli-Rus Harbi’nde cepheye gönüllü olarak giden", 0.97], [41.0, 393.0, 649.0, 421.0, "sevgilisinin ardindan savaş alaninda onunla beraber bulun-", 0.99], [39.0, 424.0, 649.0, 456.0, "mak ve onunla ayni kaderi paylaşmak için asker giysileriyle", 0.995], [40.0, 458.0, 649.0, 489.0, "Silistre savunmasina katilan genç bir kizla sevdiği genç ada-", 0.982], [41.0, 492.0, 308.0, 521.0, "min aşkini anlatmaktadir.", 0.968], [74.0, 524.0, 647.0, 553.0, "Namik Kemal ise olayin 1828 savaşında geçtiğini, fakat", 0.958], [38.0, 555.0, 649.0, 588.0, "kendisinin belki de düzenli ordu rütbesine muhtaç olan", 0.999], [41.0, 591.0, 648.0, 620.0, "Sitki Bey’in macerasini koyabilmek için” Kırim Savaşına", 0.942], [42.0, 624.0, 298.0, 653.0, "aktardiğıni söyleyecektir.", 0.976], [74.0, 656.0, 646.0, 684.0, "Namik Kemal 1868'de Mustafa Fazil Paşa'nin1 deste-", 0.968], [42.0, 691.0, 648.0, 719.0, "ğiyle Hürriyet² gazetesini çıkaracak, çeşitli anlaşmazliklar", 0.969], [39.0, 721.0, 648.0, 753.0, "nedeniyle, 1870'te Zaptiye Nazıri Hüsnü Paşa’nin çağrisiyla", 0.943], [39.0, 753.0, 648.0, 786.0, "Istanbul'a dönecektir. Nuri, Reşat ve Ebüzziya Tevfik Bey-", 0.987], [38.0, 786.0, 648.0, 818.0, "lerle 1872'de İbret3 gazetesi kiralanır. Ayni yil İbret'te çıkan", 0.95], [38.0, 819.0, 647.0, 852.0, "bir yazisi üzerine gazete dört ay kapatilacak ve Istanbul'dan", 0.982], [41.0, 855.0, 646.0, 883.0, "uzaklaştirilmak için Gelibolu Mutasarrifliğr'na atanacaktir.", 0.953], [43.0, 888.0, 645.0, 916.0, "Vatan yabut Silistre oyununu Gelibolu’da yazmaya başla-", 0.983], [40.0, 921.0, 646.0, 949.0, "yacak ve oyun 01 Nisan 1873 Sali günü Agop Efendi’nin", 0.983], [41.0, 954.0, 466.0, 983.0, "Gedikpaşa Tiyatrosu’nda sahnelenecektir.", 0.984], [42.0, 1034.0, 60.0, 1051.0, "1", 0.998], [70.0, 1030.0, 647.0, 1054.0, "Mustafa Fazil Paşa (1829-1875), Osmanli devlet adami. Avrupa’da Yeni Os-", 0.977], [74.0, 1055.0, 647.0, 1080.0, "manlilar'a parasal destekte bulunmuş, bir fon kurarak gazete çıkarmalarnı", 0.971], [73.0, 1080.0, 647.0, 1107.0, "sağlamıtr. Bu sayede Mubbir, Hürriyet, Ulûm, Fecir gibi gazzteler çeşitli", 0.962], [74.0, 1106.0, 290.0, 1131.0, "zamanlarda yayımlanmıtir.", 0.936], [39.0, 1134.0, 54.0, 1153.0, "2", 1.0], [72.0, 1128.0, 646.0, 1155.0, "Hürriyet Londra'da (1868-1870), daha sonra Cenevre'de (1870)", 0.989], [71.0, 1154.0, 595.0, 1180.0, "yayimlanan, Yeni Osmanlilar'in yayın organi haftalik siyasi gazete.", 0.972], [39.0, 1182.0, 53.0, 1201.0, "3", 1.0], [72.0, 1177.0, 647.0, 1205.0, "İbret Istanbul'da (1872-1873) cuma ve pazar dişında her gün yayımlanan,", 0.965], [74.0, 1202.0, 626.0, 1229.0, "Yeni Osmanhlar'in en etkili yayn organlanndan biri olan siyasi gazete.", 0.986], [337.0, 1259.0, 351.0, 1274.0, "V", 0.57]]}
