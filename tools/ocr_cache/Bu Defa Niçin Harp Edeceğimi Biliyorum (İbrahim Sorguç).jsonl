{"page": 7, "w": 1643, "h": 1279, "lines": [[914.0, 108.0, 1525.0, 139.0, "Temmuz 1923’te Lozan Antlamasi’nin imzasindan önce", 0.979], [70.0, 119.0, 677.0, 149.0, "ayri defterde yer alir. Bu günlüklere sonradan yapilmiış", 0.967], [69.0, 147.0, 678.0, 178.0, "hiçbir ilave yoktur. (Harp Sandiğinda bulduğumuz gün-", 0.988], [913.0, 140.0, 1523.0, 169.0, "toplam 17 kur’a askerin terhisi tamamlanmış; silah al-", 0.984], [70.0, 177.0, 678.0, 206.0, "lükler ve belgeler, araştirmacilarin erişebilmeleri için aile-", 0.986], [913.0, 170.0, 1523.0, 199.0, "tinda, ani sahibinin ifadesiyle, “artik kiymeti harbiyesi", 0.979], [70.0, 208.0, 679.0, 238.0, "miz tarafindan Genelkurmay Başkanliği ATASE Arşivine,", 0.979], [914.0, 199.0, 1524.0, 228.0, "olmayan” 21 ila 24 yaşinda 4 kur’a asker kalmişti ki", 0.963], [69.0, 236.0, 679.0, 267.0, "harp ganimetleri ise Istanbul’daki Askeri Müze’ye bağış-", 0.975], [912.0, 228.0, 1524.0, 259.0, "bunlarin yarisina yakini da savaş görmemiş tecrübesiz", 0.986], [71.0, 267.0, 679.0, 296.0, "lanmiştir. Ganimetler müzenin Kurtuluş Savaşı salonunda", 0.978], [913.0, 258.0, 1142.0, 288.0, "erlerden oluşuyordu.", 0.98], [945.0, 288.0, 1521.0, 317.0, "Içte ve dişta herkesin hayretle karşiladiği bu terhisler,", 0.965], [72.0, 298.0, 283.0, 325.0, "teşhir edilmektedir.)", 0.99], [104.0, 326.0, 678.0, 355.0, "Bu günlüğü okurken, askerin yaninda adim adim yürü-", 0.973], [913.0, 318.0, 1521.0, 347.0, "Başkumandan Mustafa Kemal Paşa’nin iyi niyet kamuflaji", 0.983], [70.0, 355.0, 679.0, 386.0, "yecek, savaşı bire bir yaşayacak, 26 Ağustos 1922 Büyük", 0.995], [913.0, 347.0, 1522.0, 376.0, "altinda uyguladiği harika diplomatik bir stratejidir. Bu ani-", 0.988], [73.0, 385.0, 679.0, 414.0, "Taarruz ile 30 Ağustos 1922 Başkumandan Meydan Mu-", 0.992], [911.0, 376.0, 1521.0, 407.0, "lar, söz konusu terhis emirlerinin nedenlerini açıkça ortaya", 0.983], [72.0, 415.0, 680.0, 444.0, "harebesi’nin içinden geçerek Izmir’e ulaşacak ve Lozan", 0.965], [912.0, 406.0