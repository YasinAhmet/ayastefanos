{"page": 1, "w": 789, "h": 1258, "lines": [[614.0, 396.0, 765.0, 419.0, "SEHADETNAMESI", 0.981], [27.0, 469.0, 740.0, 544.0, "istiklal harbi ve anadolu", 0.998], [293.0, 551.0, 478.0, 598.0, "(1921-1923)", 0.999], [179.0, 649.0, 586.0, 698.0, "Mehmet Turgut Argun", 1.0], [267.0, 1156.0, 368.0, 1187.0, "TÜRKIYE", 0.992], [392.0, 1158.0, 492.0, 1188.0, "BANKASI", 1.0], [302.0, 1209.0, 456.0, 1233.0, "Kültür Yayinlari", 0.984]]}
{"page": 12, "w": 767, "h": 1206, "lines": []}
{"page": 49, "w": 767, "h": 1226, "lines": [[147.0, 477.0, 589.0, 505.0, "Afyonkarahisar'in kurtuluşu günü, 27 Ağustos 1922.", 0.969], [164.0, 502.0, 571.0, 531.0, "Başkumandanin halkin alkişlari arasinda ayrilışi.", 0.945], [92.0, 556.0, 674.0, 593.0, "27 Ağustos – Hamdolsun bugün akşamüzeri yü-", 0.982], [59.0, 588.0, 674.0, 621.0, "rek ferahlatan haberler aldik. Öğleden sonra saat üçte", 0.996], [60.0, 618.0, 673.0, 650.0, "Afyon’a girilmiş. Bundan evve' süvarilerimiz Uşak-Bal-", 0.98], [58.0, 648.0, 673.0, 681.0, "mahmut arasindaki tren hattini geçerek demiryolunun", 0.999], [58.0, 677.0, 673.0, 711.0, "kuzeyindeki Resulbaba Dağlari’ni igal etmiştir. Düşma-", 0.976], [57.0, 707.0, 673.0, 740.0, "nin Izmir’le ulaşimi kesildiğinden kuzeye çekilmeye mec-", 0.95], [58.0, 737.0, 673.0, 769.0, "bur oldu. Izmir’le haberleşemiyor. Bugün ayni zaman-", 0.982], [58.0, 767.0, 672.0, 799.0, "da Bursa’dan da bir kart aldim. Cenab-1 Hakk daha iyi", 0.963], [58.0, 799.0, 245.0, 829.0, "günler göstersin.", 0.963], [90.0, 857.0, 670.0, 887.0, "28 Ağustos – Bugün havadisler daha güzelleşti. Düş-", 0.983], [57.0, 888.0, 670.0, 917.0, "man çok gayret veriyor ve çok perişan geri çekiliyor.", 0.985], [58.0, 917.0, 670.0, 947.0, "Afyon’u yakamadi ve üstelik 70-80 vagonlu iki tren mü-", 0.995], [56.0, 947.0, 670.0, 976.0, "himmat ve erzaki kaçıramadi. Ganimet pek fazla. Esir", 0.983], [56.0, 977.0, 669.0, 1006.0, "de çok. Ne lüzumu var. Harp kademesi Afyon’a gitti.", 0.979], [55.0, 1006.0, 670.0, 1036.0, "Birinci Ordu Balmahmut’tadir. Süvarilerin Altintaşa", 0.98], [55.0, 1036.0, 669.0, 1066.0, "vardiklari söyleniyor. On dört muhtelif top alinmiş-", 0.991], [54.0, 1065.0, 668.0, 1096.0, "tir. Herhalde asil gayenin elde edilmesi daha yakindir.", 0.975], [54.0, 1095.0, 668.0, 1126.0, "Kocaeli’den malumat yok. Belki Bursa üzerine yürüyor.", 0.977], [639.0, 1164.0, 671.0, 1195.0, "39", 1.0]]}
{"page": 58, "w": 767, "h": 1226, "lines": []}
{"page": 146, "w": 767, "h": 1226, "lines": [[232.0, 260.0, 628.0, 411.0, "KV", 0.654], [239.0, 438.0, 539.0, 464.0, "Kasaba’ya ilk giren süvari keşif kolu", 0.975], [84.0, 487.0, 697.0, 523.0, "ajansi da Istanbul’dan, Bursa’daki Yunan kuvvetlerinin", 0.989], [84.0, 518.0, 697.0, 553.0, "dağılarak öteye beriye kaçtiklarinı, yağmaya başladikla-", 0.968], [84.0, 548.0, 697.0, 581.0, "rini ve Bursa’nin yakilmakta olduğunu bildiriyordu. Biz", 0.983], [84.0, 579.0, 697.0, 610.0, "bundan sonra bu haberin ne derece doğru olduğuna dair", 0.999], [85.0, 608.0, 697.0, 640.0, "malumat almaya çalişıyorduk. Fakat sonradan anladik", 0.974], [85.0, 638.0, 698.0, 669.0, "ki böyle bir yangin olmamış ve Bursa sağlam denecek bir", 0.978], [86.0, 669.0, 698.0, 700.0, "halde elimize geçmiştir. Daha sonra gelen raporlar o ta-", 0.985], [85.0, 697.0, 698.0, 728.0, "raftaki düşmanin 11. Firkasi’nin kismen Filedar, kismen", 0.96], [86.0, 727.0, 698.0, 758.0, "Mudanya ve kismen Bandirma’da esir edildiğini bildir-", 0.992], [87.0, 758.0, 699.0, 787.0, "diler. Işte bu büyük ve muhteşem zaferleri kazandiktan", 0.979], [86.0, 786.0, 699.0, 818.0, "sonra kalbim pek ziyade genişlemişti ve artik ne kadar", 0.984], [87.0, 818.0, 700.0, 847.0, "zahmet ve cefa da olsa yine bir ayak evvel bizim de yol", 0.991], [86.0, 846.0, 699.0, 877.0, "alarak Izmir’e gitmemizi arzu etmekteydim. Heyhat ki", 0.982], [87.0, 875.0, 551.0, 906.0, "bizim kademe karinca süratiyle gidiyordu.", 0.995], [119.0, 903.0, 701.0, 938.0, "Elvanlar’dayken bir zabit Izmir’e gitti ve geldi ve bir", 0.992], [88.0, 937.0, 701.0, 967.0, "gün evvel İzmir’in en güzel parçasinin Ermeniler tara-", 0.988], [88.0, 965.0, 701.0, 996.0, "findan yakildiğini söyledi. Buna acidik. Herkes şimdi", 0.982], [87.0, 993.0, 702.0, 1028.0, "Izmir’in Kordon’unu, Buca'sinı, Karşıyaka'sinı, Kra-", 0.938], [88.0, 1024.0, 700.0, 1055.0, "mer’ini ve saire sorup duruyor. Tabii ben Izmir’i bil-", 0.974], [89.0, 1056.0, 701.0, 1086.0, "mediğim için bu yerleri de anlayamiyordum. Izmir çok", 0.971], [89.0, 1087.0, 702.0, 1117.0, "güzelmiş, güzel yerlerinin çoğu bu sefer yanmiş. Anla-", 0.983], [88.0, 1172.0, 130.0, 1203.0, "136", 0.977]]}
{"page": 202, "w": 767, "h": 1226, "lines": [[84.0, 76.0, 694.0, 106.0, "lanet okudum. Zaman ve felek insana neler gösteriyor.", 1.0], [82.0, 105.0, 387.0, 137.0, "Iyiliklere doğru gidiyoruz...", 0.975], [116.0, 134.0, 695.0, 165.0, "Mudanya’nin denizi ve mehtabi ile Haydarpaşa va-", 0.974], [83.0, 163.0, 694.0, 196.0, "purlarindan bozma posta vapurlari bana Istanbul’un", 0.989], [82.0, 193.0, 694.0, 225.0, "pek hoş kokusunu getirdi ve ruhuma sindirdi. Vaktim", 0.987], [83.0, 224.0, 694.0, 253.0, "müsait olsaydi Istanbul’a da giderdim. Ah, o tatli Istan-", 0.976], [83.0, 253.0, 694.0, 283.0, "bul hatiralari! O kadarcik olsun şimdilik Istanbul’a da", 0.977], [82.0, 282.0, 694.0, 314.0, "yaklaştiktan sonra Mudanya’dan tekrar Bursa’ya dön-", 0.972], [84.0, 313.0, 693.0, 343.0, "dük. Artik birkaç gün sonra Konya’ya doğru yine yola", 0.972], [84.0, 343.0, 694.0, 372.0, "çikacağiz. Yine görmediğim diyarlardan bir miktarinda", 0.996], [84.0, 372.0, 694.0, 401.0, "da içeceğimiz su varmış! Allah’tan bir temennim de bu", 0.971], [83.0, 401.0, 694.0, 431.0, "yabanci sulari daha uzun müddet içmemekliğimdir. Bu", 0.997], [82.0, 429.0, 693.0, 461.0, "sefer de sevgili Bursa’ya ve sevgili diyarlara veda ediyo-", 0.995], [82.0, 460.0, 693.0, 492.0, "rum. Çilelerimiz dolduysa rahat ve huzur ile karşılaşiriz.", 0.981], [82.0, 488.0, 593.0, 521.0, "Artik yetmez mi? Sabir cennetin anahtari imi!", 0.993], [492.0, 549.0, 694.0, 580.0, "Bursa, Eylül 1339", 0.992]]}
{"page": 204, "w": 767, "h": 1226, "lines": []}
{"page": 244, "w": 779, "h": 1245, "lines": [[35.0, 135.0, 394.0, 163.0, "1921 yilinda Askeri Baytar Mektebi’ni", 0.979], [60.0, 164.0, 392.0, 187.0, "bitirdikten sonra Kurtuluş Savaşina", 0.978], [60.0, 187.0, 394.0, 215.0, "Garp Cephesi’nde katilmiş, Sakarya", 0.968], [82.0, 211.0, 393.0, 239.0, "Meydan Muharebesi’nden Büyük", 0.991], [95.0, 238.0, 395.0, 264.0, "Taarruz’a cephenin başveteriner", 0.997], [70.0, 264.0, 395.0, 290.0, "muavini olarak görev yapmiş, hem", 0.971], [34.0, 288.0, 394.0, 316.0, "savaşin hem de mesleğinin zorluklarini", 0.982], [103.0, 314.0, 393.0, 342.0, "yaşamiş bir hürriyet sevdalisi...", 0.935], [114.0, 353.0, 393.0, 379.0, "Inebolu, Kastamonu, Çankiri,", 0.994], [93.0, 379.0, 396.0, 405.0, "Ankara, Akşehir, Afyon, Izmir’e", 0.979], [407.0, 376.0, 720.0, 402.0, "Mehmet Turgut Argun (1900-1982) Bursa'da", 0.978], [56.0, 405.0, 395.0, 431.0, "kadar Anadolu’nun çeşitli yerlerinde", 0.997], [406.0, 399.0, 699.0, 424.0, "doğdu. 1912'de Askeri Rüştiye'yi, 1915'te", 0.946], [59.0, 430.0, 395.0, 458.0, "görev yapan Mehmet Turgut Bey ve", 1.0], [406.0, 421.0, 712.0, 446.0, "Kuleli Askeri Lisesi'ni bitirdi. 1918'de Askeri", 0.963], [409.0, 446.0, 737.0, 469.0, "Veteriner Yüksekokulu'nu bitirip 1921'de stajini", 0.992], [41.0, 456.0, 394.0, 482.0, "arkadaşlari, bütün bu zaman boyunca", 0.984], [408.0, 469.0, 742.0, 492.0, "tamamladiktan sonra Kurtuluş Savaşi'na katildi.", 0.956], [36.0, 480.0, 396.0, 509.0, "başka cephelerden gelecek iyi haberleri", 0.99], [408.0, 490.0, 725.0, 516.0, "Garp Cephesi başveteriner yardimcisi olarak", 0.99], [88.0, 507.0, 395.0, 533.0, "ve barişi beklerlerken bir yandan", 0.979], [409.0, 514.0, 742.0, 537.0, "1923 yilinda savaştaki görevi sona erdi. 1924'te", 0.977], [94.0, 531.0, 396.0, 559.0, "da türlü imkânsizliklara rağmen", 0.991], [408.0, 536.0, 740.0, 562.0, "Birinci Ordu Müfettişliği başveteriner yardimcisi", 0.95], [166.0, 556.0, 397.0, 585.0, "görevlerini aksatmamak", 1.0], [407.0, 559.0, 747.0, 585.0, "olarak görev yapti. Haydarpaşa Askeri Veteriner", 0.987], [249.0, 579.0, 397.0, 612.0, "için çabalarlar.", 0.999], [409.0, 583.0, 709.0, 606.0, "Tatbikat Okulu salgin hastaliklar asistanliği", 0.985], [408.0, 605.0, 718.0, 630.0, "yapti, 1928'de başmuavin oldu ve ayni yil iç", 0.972], [39.0, 621.0, 397.0, 649.0, "Mehmet Turgut Argun 1921-22 yillari", 0.997], [406.0, 625.0, 719.0, 653.0, "ve salgin hastaliklar ihtisasi için Almanya'ya", 0.961], [47.0, 648.0, 397.0, 674.0, "arasinda tuttuğu günlüğünde cepheye", 0.998], [408.0, 649.0, 746.0, 675.0, "gönderildi. Berlin Veteriner Yüksek Okulu'nun i", 0.982], [33.0, 673.0, 396.0, 699.0, "dair gözlemlerini aktarirken, “Anadolu", 0.999], [408.0, 671.0, 745.0, 698.0, "hastaliklari kliniklerinde çalişti. Viyana Veteriner", 0.984], [101.0, 697.0, 396.0, 725.0, "Hatira Defteri” başliğiyla 1923", 0.974], [410.0, 696.0, 721.0, 719.0, "Yüksekokulu'ndan 1930'da doktora derecesi", 0.995], [43.0, 723.0, 396.0, 751.0, "yilinda yazdiği anilarinda Anadolu’da", 0.993], [409.0, 717.0, 739.0, 744.0, "aldi. Askeri Veteriner Tatbikat Okulu'nda salgin", 0.973], [39.0, 749.0, 397.0, 777.0, "bulunduğu yerler, oralarin insanlari ve", 0.988], [409.0, 742.0, 720.0, 765.0, "hastaliklar öğretim üyeliğine atandi. 1938'de", 0.968], [410.0, 765.0, 735.0, 788.0, "binbaşi ve yarbay rütbelerine terfi etti. 1938-51", 0.984], [138.0, 776.0, 396.0, 802.0, "savaşa dair hislerini anlatir.", 0.982], [410.0, 788.0, 747.0, 811.0, "yillari arasinda Tarim Bakanliği Veteriner Genel", 0.99], [143.0, 813.0, 398.0, 842.0, "Kurtuluş Savaşinin önemli", 0.979], [409.0, 808.0, 758.0, 836.0, "Müdürlüğü'nde mütehassis müçavir olarak Salgin", 0.966], [35.0, 839.0, 397.0, 869.0, "sahsiyetlerinin ve cephe fotoğraflarinin", 0.983], [410.0, 832.0, 684.0, 858.0, "Hastaliklar Şubesinin idaresini yürüttü.", 0.983], [411.0, 855.0, 759.0, 881.0, "1953'te Eczacibaşı ilaç Fabrikasi Veteriner Ilaçlar", 0.931], [128.0, 868.0, 395.0, 891.0, "yer aldiği kendi albümünden", 0.99], [410.0, 878.0, 767.0, 904.0, "Şubesi'ni ve Türkiye'deki ilk veteriner ilaçlari imalat", 0.947], [46.0, 891.0, 399.0, 920.0, "fotoğraflarla birlikte, Mehmet Turgut", 0.983], [410.0, 901.0, 762.0, 927.0, "sanayini kurdu. Başak Sigorta Şirketi'nde Hayvan", 0.968], [104.0, 918.0, 397.0, 944.0, "Bey’in anilari döneme farkli bir", 0.987], [409.0, 923.0, 762.0, 951.0, "Sigortasi'ni kurdu ve 1967'ye kadar burada çalişti.", 0.974], [220.0, 942.0, 398.0, 971.0, "taniklik sunuyor...", 0.975], [409.0, 945.0, 762.0, 974.0, "Veterinerlikle ilgili çalişmalar, bilimsel araştirmalar", 0.936], [409.0, 969.0, 762.0, 997.0, "ve önemli buluşlar yapti, bunlari Türkçe, Almanca,", 0.987], [410.0, 992.0, 734.0, 1018.0, "Fransizca olarak makaleler ve kitaplar halinde", 0.982], [411.0, 1016.0, 489.0, 1040.0, "yayimladi.", 0.991], [507.0, 1137.0, 539.0, 1156.0, "THG", 1.0], [482.0, 1149.0, 540.0, 1170.0, "945333", 1.0], [236.0, 1169.0, 351.0, 1196.0, "KDV dahil fiyati", 0.947], [507.0, 1163.0, 539.0, 1182.0, "CEZ", 0.999], [27.0, 1191.0, 217.0, 1214.0, "9786053\"322214\"", 0.977], [238.0, 1194.0, 292.0, 1220.0, "12 TL", 0.985]]}
