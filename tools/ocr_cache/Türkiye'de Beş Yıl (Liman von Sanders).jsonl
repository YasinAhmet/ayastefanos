{"page": 191, "w": 740, "h": 1179, "lines": [[234.0, 421.0, 508.0, 447.0, "Bağdat demiryolu, cepheye nakil", 0.993], [63.0, 474.0, 674.0, 505.0, "lordu’nun menzil yolunda Alman otomobilleri çalmaya", 0.982], [63.0, 504.0, 196.0, 534.0, "başlatilmiti.", 0.968], [97.0, 532.0, 674.0, 562.0, "Eylül ayinda, Alman pilot subaylardan ve 6. Ordu'dan", 0.977], [64.0, 561.0, 675.0, 590.0, "gelen diğer Alman subaylardan, Dicle boyunca Íngiliz cephe-", 0.992], [64.0, 590.0, 676.0, 618.0, "sine doğru süratle ilerleyen demiryolu inşasina ve bu nehir", 0.986], [63.0, 616.0, 674.0, 647.0, "üzerinde her türden Ingiliz nakliye gemilerinin çok arttiğına", 0.971], [66.0, 646.0, 351.0, 673.0, "dair çok kesin bilgiler aldim.", 0.958], [98.0, 674.0, 675.0, 703.0, "Bu haberleri Enver Paşa’ya bildirdim ve yakin zamanda", 0.987], [65.0, 702.0, 676.0, 731.0, "Bağdat’in ciddi bir teblikeye maruz kalmasinin beklendiği", 0.969], [65.0, 731.0, 349.0, 758.0, "hususunda dikkatini çektim.", 0.977], [97.0, 760.0, 675.0, 789.0, "Enver Paşa, 3., 2. ve 6. Orduların, yani Türklerin Doğu Cep-", 0.988], [63.0, 786.0, 675.0, 817.0, "hesi’nin müterek bir kumanda altinda birleştirilmesi için birkaç", 0.968], [63.0, 816.0, 618.0, 844.0, "hafta önce yaptiğım teklif hakkinda bir karar verememişti.", 0.971], [96.0, 841.0, 675.0, 873.0, "Istanbul'da Bağdat'in güvenliğinin güçlendirilmesi husu-", 0.973], [64.0, 872.0, 675.0, 901.0, "sunda bir şey elde edemeyince bu endielerimi Kayzer’in o si-", 0.984], [63.0, 900.0, 676.0, 929.0, "rada Türkiye’de bulunan seryaveri von Chelius’a bildirdim", 0.989], [63.0, 927.0, 676.0, 958.0, "ve General Ludendorff'a aşağidaki raporu sundum. General", 0.982], [64.0, 957.0, 675.0, 986.0, "von Chelius bu raporu General Ludendorff’a Pletz’de şahsen", 0.983], [64.0, 986.0, 675.0, 1015.0, "verdi. Bunun doğrudan sonucu olarak, Aralik ayinda brifing", 0.985], [64.0, 1013.0, 674.0, 1042.0, "vermek üzere Pletz’e Genel Karargâh’a çağrildim. Bu hususta", 0.987], [66.0, 1043.0, 339.0, 1069.0, "daha sonra bilgi vereceğim.", 0.999], [64.0, 1121.0, 106.0, 1149.0, "186", 0.992]]}
