{"page": 488, "w": 854, "h": 1297, "lines": [[37.0, 112.0, 439.0, 137.0, "Ordu Grubu’nun kumandasini Ekselanslari", 0.993], [35.0, 137.0, 392.0, 163.0, "Mustafa Kemal’in birçok şanli savaşta", 0.973], [36.0, 163.0, 447.0, 189.0, "muzaffer olmuş ellerine birakmak durumunda", 0.991], [36.0, 189.0, 412.0, 215.0, "olduğum anda, benim emrimde Osmanli", 0.981], [36.0, 215.0, 447.0, 240.0, "Imparatorluğu’nun uğruna ifa ettikleri görevler", 0.987], [37.0, 242.0, 423.0, 265.0, "için bütün subaylara, memurlara ve erlere", 0.99], [36.0, 266.0, 266.0, 292.0, "candan teşekkür ederim.", 0.991], [35.0, 291.0, 442.0, 316.0, "Beni Ordu Grubu’na mensup birçok subaya", 0.987], [37.0, 318.0, 440.0, 341.0, "ve askerlere çok yakinlaştiran Gelibolu’nun", 0.986], [36.0, 343.0, 447.0, 369.0, "şanli günleri ve Anadolu sahilinde yürütülen", 0.99], [35.0, 367.0, 447.0, 394.0, "birçok cesur harekât, bütün çağların tarihinde", 0.972], [36.0, 393.0, 238.0, 419.0, "unutulmayacaklardir.", 0.979], [239.0, 443.0, 448.0, 469.0, "Adana, 31 Ekim 1918", 0.988], [266.0, 471.0, 447.0, 493.0, "Liman von Sanders", 1.0], [37.0, 519.0, 449.0, 547.0, "Liman von Sanders Alman genelkurmayinin", 0.997], [48.0, 548.0, 446.0, 570.0, "Osmanli ordusuna verdiği askeri ve lojistik", 0.997], [470.0, 562.0, 795.0, 584.0, "Liman von Sanders (1855-1929) 1874'te Essen", 0.992], [45.0, 572.0, 448.0, 598.0, "destek çerçevesinde Alman Askeri Misyonu", 0.991], [470.0, 584.0, 757.0, 607.0, "Prensliği ordusunda kadet olarak askerlik", 0.985], [42.0, 597.0, 448.0, 623.0, "başkani olarak Osmanli Imparatorlugu’nda", 0.972], [469.0, 609.0, 795.0, 632.0, "mesleğine başladi, 1908'de tümgeneralliğe terfi", 0.991], [36.0, 624.0, 448.0, 649.0, "görevlendirilir ve savaşin sonuna dek görevini", 0.993], [469.0, 634.0, 765.0, 656.0, "etti. 1913 yilinda Alman ordusu tarafindan,", 0.99], [57.0, 648.0, 447.0, 674.0, "sürdürür. Türkler arasinda “Liman Paşa”", 0.985], [469.0, 657.0, 795.0, 680.0, "Osmanli ordusundaki islahat çalişmalarina destek", 0.969], [36.0, 674.0, 448.0, 700.0, "adiyla anilan von Sanders, Malta sürgünlüğü", 0.984], [467.0, 680.0, 775.0, 705.0, "veren heyetin başkani olarak görevlendirildi.", 0.989], [69.0, 698.0, 447.0, 727.0, "sirasinda yazdiği ve 1920'de yayimladiği", 0.964], [467.0, 703.0, 796.0, 730.0, "Birinci Dünya Savaşı’na girerken Çanakkale'deki", 0.961], [66.0, 726.0, 449.0, 751.0, "anilarinda Birinci Dünya Savaşi boyunca", 0.997], [470.0, 730.0, 750.0, 752.0, "Beşinci Ordu'nun komutanliğina getirildi.", 0.974], [82.0, 750.0, 448.0, 776.0, "Kafkasya, Süveys Kanali, Çanakkale ve", 0.968], [470.0, 753.0, 794.0, 776.0, "1917-18'de Filistin ve Suriye'de kurulan Yildirim", 0.982], [106.0, 775.0, 446.0, 803.0, "Filistin’de yaşadiklarimi kayda geçer.", 0.954], [467.0, 775.0, 790.0, 802.0, "Ordulari'nin grup komutani olarak görev yapti.", 0.97], [468.0, 801.0, 764.0, 823.0, "Mondros Mütarekesi'nin ardindan 1919'da", 0.974], [80.0, 828.0, 448.0, 851.0, "Türkiye’de Beş Yil’in Almanca aslindan", 0.973], [468.0, 825.0, 782.0, 848.0, "Malta'ya sürgün edildi, burada savaş suçlusu", 0.985], [63.0, 852.0, 449.0, 878.0, "eksiksiz olarak yapilan bu çevirisi, Askeri", 0.986], [467.0, 848.0, 793.0, 873.0, "olarak yargilandi, alti ay sonra serbest birakildi", 0.992], [37.0, 879.0, 448.0, 905.0, "Tarih Encümeni’nin 1921'de yaptiği çevirideki", 0.978], [468.0, 874.0, 756.0, 897.0, "ve Almanya'ya döndü. Münih'te vefat etti.", 0.96], [117.0, 904.0, 447.0, 929.0, "eleştirel ya da açiklayici dipnotlarla", 0.99], [41.0, 929.0, 447.0, 955.0, "“Encümenin Düşünceleri” eki ve döneme ait", 0.993], [79.0, 955.0, 447.0, 981.0, "fotoğraflarla genişletildi. Birinci Dünya", 0.996], [64.0, 981.0, 447.0, 1006.0, "Savaşìnin en sicak cephelerini önemli bir", 0.973], [35.0, 1004.0, 445.0, 1032.0, "aktörünün gözünden okumak isteyenler için...", 0.978], [391.0, 1115.0, 420.0, 1130.0, "THG", 1.0], [385.0, 1125.0, 436.0, 1148.0, "705768", 0.99], [393.0, 1141.0, 423.0, 1159.0, "SGT", 0.997], [52.0, 1221.0, 238.0, 1241.0, "9789944888875", 1.0], [677.0, 1217.0, 751.0, 1253.0, "28 TL", 1.0]]}
